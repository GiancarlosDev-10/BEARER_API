    },
    {
      "name": "2-Login",
      "description": "Usuario + contraseña se cambian por un Bearer Token (JWT).",
      "item": [
        {
          "name": "Login ana (ADMIN) → guarda {{token}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como **ana** (rol ADMIN). El script de *Tests* guarda el `accessToken` en `{{token}}` para las demás peticiones. **Ejecútalo primero.**",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ana\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "// Guarda el token en la variable de colección {{token}}",
                  "pm.collectionVariables.set(\"token\", datos.accessToken);",
                  "console.log(\"Token de ana guardado. Vence en \" + datos.expiraEnSegundos + \" s\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login carlos (CLIENTE) → guarda {{tokenCliente}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como **carlos** (rol CLIENTE). Guarda su token en `{{tokenCliente}}` para mostrar el 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"carlos\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "// Guarda el token en la variable de colección {{tokenCliente}}",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Contraseña incorrecta → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Mismo mensaje si falla el usuario o la contraseña, para no revelar qué usuarios existen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ana\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3-Bearer Token (200-401-403)",
      "description": "Los casos del Bearer Token sobre `PATCH /api/productos/2`. Requiere haber ejecutado los dos logins.",
      "item": [
        {
          "name": "Mis datos según el token (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "me"
              ]
            },
            "description": "El servidor lee el token y responde quién eres, tu rol y cuándo vence."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH con token de ana (ADMIN) → 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "2"
              ]
            },
            "description": "Token válido y rol ADMIN: la operación se permite.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 139.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH sin token → 401",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "2"
              ]
            },
            "description": "Sin header `Authorization`: el servidor no sabe quién eres → **401 Unauthorized**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH con token falso → 401",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer abc.def.ghi"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "2"
              ]
            },
            "description": "Un token inventado no tiene una firma válida → **401 Unauthorized**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH con token de carlos (CLIENTE) → 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "2"
              ]
            },
            "description": "El token es válido (el servidor sabe que eres carlos), pero tu rol no tiene permiso → **403 Forbidden**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST crear producto (ADMIN) → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Crear devuelve **201 Created** y el header `Location` con la URL del nuevo producto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Webcam Logitech C920\",\n  \"precio\": 289.9,\n  \"stock\": 20,\n  \"categoria\": \"perifericos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Trae header Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4-API Key (200-401)",
      "description": "El sistema proveedor (otro servidor) actualiza stock enviando una API Key en el header `X-API-KEY`. Pega la key real en el entorno (variable `apiKey`).",
      "item": [
        {
          "name": "Actualizar stock con API Key → 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/proveedor/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "proveedor",
                "stock"
              ]
            },
            "description": "API Key correcta: el proveedor actualiza el stock. Responde el stock anterior y el nuevo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin API Key → 401",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/proveedor/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "proveedor",
                "stock"
              ]
            },
            "description": "Sin header `X-API-KEY` → **401**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "API Key incorrecta → 401",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "clave-incorrecta"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/proveedor/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "proveedor",
                "stock"
              ]
            },
            "description": "Una key distinta → **401** (el servidor compara en tiempo constante).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bearer de ana en lugar de API Key → 401",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/proveedor/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "proveedor",
                "stock"
              ]
            },
            "description": "Esta ruta **solo** acepta API Key: ni siquiera un token de ADMIN sirve. Cada credencial tiene su propósito.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5-PUT vs PATCH",
      "description": "El \"caso de Ana\": PUT reemplaza el recurso completo; PATCH cambia solo lo enviado. Ejecutar en orden (requiere el login de ana).",
      "item": [
        {
          "name": "1) Ver Mouse antes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "1"
              ]
            },
            "description": "Estado inicial del producto 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2) PATCH solo precio → los demás campos se conservan",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "1"
              ]
            },
            "description": "PATCH = actualización **parcial**: solo cambia el precio.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 39.9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El nombre se conserva\", () => pm.expect(pm.response.json().nombre).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "3) PUT solo precio → ¡el caso de Ana! (campos en null)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "1"
              ]
            },
            "description": "PUT = **reemplazo total**: lo que no se envía queda en `null`. Ana quería cambiar el precio y \"borró\" el producto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 39.9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El nombre quedó en null\", () => pm.expect(pm.response.json().nombre).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "4) PUT completo → forma correcta de usar PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "1"
              ]
            },
            "description": "Con PUT hay que enviar **todos** los campos. Esto también restaura el producto.",
            "body": {
              "mode": "raw",
