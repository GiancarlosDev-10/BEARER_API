<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = la "receta" del proyecto para Maven.
  Aquí se declara: qué versión de Java usamos, qué librerías (dependencias)
  necesitamos y cómo se construye el .jar final.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Heredamos la configuración de Spring Boot (versiones compatibles entre sí) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>pe.techstore</groupId>
    <artifactId>techstore-api</artifactId>
    <version>1.0.0</version>
    <name>TechStore API</name>
    <description>Taller API Keys vs. Bearer Tokens - TechStore</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web: permite crear endpoints REST (controladores) con un servidor Tomcat incluido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Pruebas automáticas (JUnit, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empaqueta todo en un único .jar ejecutable con "java -jar" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
