<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = la "receta" del proyecto para Maven.
  Aquí se declara: qué versión de Java usamos, qué librerías (dependencias)
  necesitamos y cómo se construye el .jar final.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Heredamos la configuración de Spring Boot (versiones compatibles entre sí) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>pe.techstore</groupId>
    <artifactId>techstore-api</artifactId>
    <version>1.0.0</version>
    <name>TechStore API</name>
    <description>Taller API Keys vs. Bearer Tokens - TechStore</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <springdoc.version>2.10.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- Spring Web: permite crear endpoints REST (controladores) con un servidor Tomcat incluido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: guardar y leer objetos Java en una base de datos sin escribir SQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2: base de datos que vive en memoria (se borra al apagar el servidor). Ideal para demos -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation: reglas como @NotBlank o @Positive para revisar los datos que llegan -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security: protege las rutas (quién puede entrar a cada endpoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- jjwt: crear y verificar tokens JWT (los Bearer Tokens de esta API) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- springdoc-openapi: genera la documentación de la API y la página Swagger UI
             (/swagger-ui.html) para probar los endpoints desde el navegador.
             La versión 2.x es la que corresponde a Spring Boot 3. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Configuration Processor: al compilar, lee las clases @ConfigurationProperties
             y genera un archivo de "metadatos". El editor lo usa para reconocer nuestras
             propiedades (techstore.*) en application.yml: autocompletado y sin avisos.
             "optional" = solo se usa al compilar, no viaja dentro del .jar final. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas automáticas (JUnit, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empaqueta todo en un único .jar ejecutable con "java -jar" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
